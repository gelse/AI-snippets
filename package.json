{
  "name": "@gelse/ai-snippets",
  "version": "0.1.0",
  "type": "module",
  "description": "Installer CLI for AI-snippets: skills and agent modes for AI coding tools",
  "bin": {
    "ai-snippets": "dist/cli.cjs"
  },
  "files": [
    "dist/",
    "skills-embedded/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node scripts/stage-embedded.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
